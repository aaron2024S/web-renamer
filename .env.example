# 复制为 .env 后按需修改（docker compose 会自动读取）

# 预设 / 历史 / 设置 / 账号 的持久化目录
CONFIG_DIR=/config

# 服务端口（容器内监听端口，改动时记得同步 docker-compose 的端口映射）
PORT=7582

# 以哪个用户身份处理文件（NAS 场景建议设置成共享文件夹的属主）
PUID=1000
PGID=1000

TZ=Asia/Shanghai

# 日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── 首次登录账号（仅首次启动生效，之后以数据库里存的口令为准）──
# AUTH_USER=admin
# AUTH_PASSWORD=admin123

# ── 登录防爆破（不填即用默认值）──
# LOGIN_MAX_ATTEMPTS=5         # 窗口内失败几次就锁定
# LOGIN_WINDOW_MS=600000       # 失败计数窗口（10 分钟）
# LOGIN_LOCK_MS=900000         # 首次锁定时长（15 分钟），连续锁定按倍数递增
# LOGIN_LOCK_MAX_MS=3600000    # 锁定上限（1 小时）
# LOGIN_DELAY_BASE_MS=600      # 失败后递增延迟起点
# LOGIN_DELAY_MAX_MS=4000      # 递增延迟上限
# SESSION_TTL_MS=604800000     # 登录有效期（7 天）
# TRUST_PROXY=false            # 放在反向代理后面才设为 true

# 可选：允许操作的根目录（容器内路径），留空即默认 /data
# 目录都挂到 /data 下时无需设置这一项
# ROOTS=/data
