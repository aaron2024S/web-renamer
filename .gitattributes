# 统一换行符，避免 Windows 上的 CRLF 污染仓库
* text=auto eol=lf

# shell 脚本必须是 LF，否则 Alpine 容器里会报 \r 相关错误
*.sh text eol=lf
docker/* text eol=lf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary
*.tar binary
*.mp3 binary
*.sqlite binary
*.sqlite3 binary
*.db binary
